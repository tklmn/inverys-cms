            "require": {"php": ">=8.1", "ext-json": "*", "psr/log": "^2.0 || ^3.0"}
        },
        {
            "name": "psr/log",
            "version": "3.0.2",
            "type": "library",
            "license": ["MIT"],
            "description": "Common interface for logging libraries",
