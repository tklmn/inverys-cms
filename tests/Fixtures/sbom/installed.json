            "type": "library",
            "license": ["BSD-3-Clause", "GPL-2.0-only", "GPL-3.0-only"],
            "support": {"source": "https://github.com/nette/utils/tree/v4.0.8"},
            "require": {"php": "8.0 - 8.5"}
        },
        {
            "name": "symfony/polyfill-mbstring",
            "version": "v1.33.0",
            "type": "library",
            "license": ["MIT"],
            "require": {"php": ">=7.2"},
            "replace": {"symfony/polyfill-mb": "*"}
        },
        {
            "name": "acme/fixture-plugin",
            "version": "2.1.0",
