APP_NAME="Inverys CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# Security hardening — see docs/SECURITY-HARDENING.md
# Extra host names besides the APP_URL host and its subdomains ("*" = no check)
TRUSTED_HOSTS=
# Reverse proxy IPs/CIDRs whose X-Forwarded-* headers are trusted
TRUSTED_PROXIES=
# Edit theme files and upload theme/plugin packages in the backend (admins only).
# false = switched off, changes only via Git/deployment (recommended in production)
CMS_CODE_EDITING=true
# Updates (System > Updates): where CMS releases are looked up (GitHub owner/repo);
# a token is only needed for private repositories
CMS_UPDATE_REPOSITORY=tklmn/inverys-cms
CMS_UPDATE_TOKEN=
# /.well-known/security.txt (RFC 9116) — served only when a contact is set
SECURITY_TXT_CONTACT=
SECURITY_TXT_EXPIRES=
SECURITY_TXT_POLICY=
SECURITY_TXT_LANGUAGES="en, de"

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
